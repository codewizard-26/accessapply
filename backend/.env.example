# Server Port
PORT=3000

# PostgreSQL Connection String (Neon)
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Environment (development | production)
NODE_ENV=development

# Optional: Comma-separated allowed CORS origins (defaults to reflecting caller origin)
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
